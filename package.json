{
  "name": "mailpulse",
  "version": "1.0.0",
  "private": true,
  "description": "MailPulse - Full-Stack Email Campaign Management and Analytics Platform",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -k --names \"server,client\" -c \"cyan,magenta\" \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm --prefix client run dev",
    "dev:server": "npm --prefix server run dev",
    "build": "npm run build:client",
    "build:client": "npm --prefix client run build",
    "start:server": "npm --prefix server start",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm --prefix server test",
    "test:client": "npm --prefix client test"
  },
  "keywords": [
    "mern",
    "email-marketing",
    "campaign-manager",
    "analytics"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.6"
  }
}
