NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mailpulse
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

# Authentication & JWT Security Settings
# Cryptographically secure random secret (minimum 32 characters required for HS256)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
# Short-lived access token lifetime (default: 15m)
JWT_EXPIRES_IN=15m
# Token Issuer & Audience claims
JWT_ISSUER=mailpulse-api
JWT_AUDIENCE=mailpulse-client

# Optional Email & SMTP Transport Settings (Phase 4.4)
# Opt-in: When omitted, real sending is disabled and the service fails closed.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your_smtp_username
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=MailPulse <noreply@mailpulse.local>

# Campaign Test Email Rate Limit (Phase 4.4 Step 3)
# Per-user limit for POST /api/v1/campaigns/:id/test-email (default: 5 requests per 15 minutes)
TEST_EMAIL_RATE_LIMIT_WINDOW_MS=900000
TEST_EMAIL_RATE_LIMIT_MAX=5

# Campaign Sending (Phase 5)
# Number of messages sent in parallel per campaign (default 5, max 20)
CAMPAIGN_SEND_CONCURRENCY=5
# Per-user limit for POST /api/v1/campaigns/:id/send (default: 10 requests per hour)
CAMPAIGN_SEND_RATE_LIMIT_WINDOW_MS=3600000
CAMPAIGN_SEND_RATE_LIMIT_MAX=10
