NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
MONGODB_URI=mongodb://127.0.0.1:27017/mailpulse
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
SHUTDOWN_TIMEOUT_MS=10000

# Authentication & JWT Security Settings
# Cryptographically secure random secret (minimum 32 characters required for HS256)
JWT_SECRET=replace_with_a_secure_random_secret_at_least_32_characters_long
# Short-lived access token lifetime (default: 15m)
JWT_EXPIRES_IN=15m
# Token Issuer & Audience claims
JWT_ISSUER=mailpulse-api
JWT_AUDIENCE=mailpulse-client
